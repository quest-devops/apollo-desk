# ApolloDesk — bloco para o Caddyfile compartilhado, em /root/apollo-cloud/deploy/Caddyfile.
#
# ⚠️ DUAS ARMADILHAS AO MEXER NAQUELE ARQUIVO — as duas já custaram tempo:
#
# 1. Ele é BIND MOUNT preso por inode: NÃO usar `sed -i` nem `mv` (quebra o
#    vínculo e o container passa a ler um arquivo fantasma). Editar em cima do
#    próprio arquivo (`cat >>` / `tee`), com backup datado antes.
#
# 2. NÃO substituir este bloco procurando o primeiro `
}` depois do nome do
#    host. O bloco tem um bloco ANINHADO (`reverse_proxy { ... }`), então o
#    primeiro `}` fecha o interno, não o vhost — em 01/set um script assim
#    apagou o vhost inteiro e o ApolloDesk saiu do ar sem nenhum erro no
#    Caddy (a config seguia válida, só não tinha mais o host).
#    Para atualizar: remover o bloco à mão, conferindo, e reanexar este
#    arquivo com `cat >>`.
#
# Endereço provisório: o definitivo é app.apollodesk.com.br, pendente do registro
# do domínio apollodesk.com.br (E7 · APOLLO-140). Trocar aqui E no FRONTEND_URL.

desk.apollosolution.com.br {
	encode zstd gzip
	header Strict-Transport-Security "max-age=15552000; includeSubDomains"

	# ⚠️ O ActionCable do Chatwoot é WebSocket e é o que faz a conversa
	# atualizar sozinha. Sem passar o Upgrade, o inbox "trava" e o agente
	# só vê mensagem nova ao recarregar a página — parece bug de produto.
	# ⚠️ O CACHE DE UM ANO PRECISA SER QUEBRADO AQUI — e este é o motivo, que
	# custou uma rodada inteira de "não mudou nada":
	#
	# O Rails serve /brand-assets/* e /vite/assets/* com
	# Cache-Control: max-age=31556952. Para o Chatwoot isso é seguro, porque o
	# nome dos bundles carrega hash do CONTEÚDO DELE. Só que o nosso rebrand
	# reescreve o conteúdo DEPOIS do build do Chatwoot — o arquivo muda, o nome
	# não. Resultado: o navegador de quem já visitou fica preso ao CSS azul e
	# ao logo antigo por um ano, e a marca nova só aparece em aba anônima.
	#
	# `no-cache` NÃO desliga o cache: manda revalidar. O ETag continua valendo,
	# então o custo é um 304 por carga, e a marca passa a chegar de verdade.
	# Os ícones de aba/PWA NÃO estão sob /brand-assets: são ~30 PNGs soltos na
	# raiz (favicon-*, apple-icon-*, android-icon-*, ms-icon-*) e ficaram de
	# fora da primeira versão deste matcher — por isso continuavam com o cache
	# de um ano. Seus nomes são fixos pelo layout, então não dá para versionar:
	# aqui o no-cache é a única saída.
	@marca path /brand-assets/* /vite/assets/* /favicon* /apple-icon* /apple-touch-icon* /android-icon* /ms-icon*
	# O prefixo `>` importa: sem ele o Caddy ACRESCENTA um segundo
	# Cache-Control e a resposta sai com os dois (o de um ano inclusive),
	# valendo o do Rails. `>` substitui o cabeçalho na resposta do proxy.
	header @marca >Cache-Control "no-cache"

	reverse_proxy apollo-desk-rails:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
