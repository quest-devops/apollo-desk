# ApolloDesk — modelo do .env. NUNCA commitar o .env real (o .gitignore barra).
# Os segredos são gerados NO SERVIDOR, em /root/plan-secrets/apollo-desk.env (600).

# ── O que faz a marca Apollo sobreviver ───────────────────────────────────────
# ⚠️ A LINHA MAIS IMPORTANTE DESTE ARQUIVO.
# Com a pasta enterprise/ ativa, o job Internal::ReconcilePlanConfigService
# RESETA logo, nome e URLs para "Chatwoot" sempre que o plano é community —
# e ele roda em background, então o rebrand parece funcionar e some depois.
# Isto também mantém o build 100% MIT, que é a base legal do rebrand.
DISABLE_ENTERPRISE=true

# ── Identidade da instalação ─────────────────────────────────────────────────
# ⚠️ ARMADILHA VERIFICADA EM 28/ago/2026 (E1): NÃO existe variável de ambiente
# de marca no Chatwoot. INSTALLATION_NAME, BRAND_NAME, BRAND_URL,
# WIDGET_BRAND_URL e LOGO são valores HARDCODED em config/installation_config.yml
# e viram linhas de InstallationConfig no banco no primeiro seed. Pôr essas
# chaves aqui não faz absolutamente nada — foi testado: o .env trazia
# INSTALLATION_NAME=ApolloDesk e o banco continuou "Chatwoot".
#
# Pior: no YAML elas são `locked: true`, então também NÃO aparecem na tela de
# Installation Config do super_admin. O único caminho é escrever na tabela via
# console — é o conteúdo da etapa E3 (APOLLO-136).
#
# O que o DISABLE_ENTERPRISE acima garante é que, uma vez escrito, o valor
# PERSISTE (sem ele o ReconcilePlanConfigService reverte para "Chatwoot").

# ── URL e segurança ──────────────────────────────────────────────────────────
# ⚠️ HTTPS desde o primeiro boot. O Chatwoot monta URL absoluta de widget,
# webhook e callback a partir daqui; nascendo em http:// o widget carrega
# conteúdo misto e o webhook da Meta é recusado (a Meta exige https).
FRONTEND_URL=https://desk.apollosolution.com.br
FORCE_SSL=true

# Gerar no servidor: openssl rand -hex 64
SECRET_KEY_BASE=

# ── Cadastro fechado ─────────────────────────────────────────────────────────
# Instância nossa, com convite. Aberto, qualquer um cria conta no nosso domínio.
ENABLE_ACCOUNT_SIGNUP=false

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────────
# A senha aparece duas vezes de propósito: o servidor Redis lê REDIS_PASSWORD e
# o Rails lê a URL. Se divergirem, o Sidekiq sobe e não processa nada.
REDIS_PASSWORD=
REDIS_URL=redis://:SENHA_AQUI@redis:6379

# ── Rails ────────────────────────────────────────────────────────────────────
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
DEFAULT_LOCALE=pt_BR
ACTIVE_STORAGE_SERVICE=local

# ── E-mail (via ApolloMail / Stalwart) ───────────────────────────────────────
# Sem isto, convite de agente e recuperação de senha falham EM SILÊNCIO: a tela
# diz que enviou e nada sai. Foi a primeira coisa a bloquear o uso em equipe.
#
# ⚠️ PORTA 465, NÃO 587. O Stalwart publica a 587 no Docker mas NÃO há quem
# escute nela — testado de dentro da rede do Desk: 25 e 465 abertas, 587
# recusando conexão. Por isso TLS implícito (SMTP_TLS) em vez de STARTTLS.
#
# O host é o público (mail.apollomail.com.br) e não o nome do container: os dois
# stacks estão em redes Docker diferentes, e usar o host público ainda garante
# certificado válido — o nome do container não está no cert.
MAILER_SENDER_EMAIL=ApolloDesk <apollodesk@apollosolution.com.br>
SMTP_ADDRESS=mail.apollomail.com.br
SMTP_PORT=465
SMTP_DOMAIN=apollosolution.com.br
SMTP_USERNAME=apollodesk@apollosolution.com.br
# ⚠️ NÃO é a senha da caixa — é uma SENHA DE APLICATIVO, e isto não é detalhe:
# o Stalwart do ApolloMail usa um diretório EXTERNO (OIDC, contra o ApolloAuth),
# e conta em diretório externo NÃO ACEITA senha local. Tentar definir uma no
# console devolve "Cannot set credentials for accounts in an external directory".
#
# O caminho suportado é a senha de aplicativo, criada por
# `x:AppPassword/set` com accountId = id da conta (não o de gestão). O `secret`
# é GERADO PELO SERVIDOR (é server-set; mandar um valor é recusado) e
# `description` é obrigatório. Vale para QUALQUER app da casa que precise
# autenticar SMTP/IMAP no ApolloMail — os clientes tradicionais não falam
# OAUTHBEARER com IdP externo.
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_TLS=true
SMTP_ENABLE_STARTTLS_AUTO=false
