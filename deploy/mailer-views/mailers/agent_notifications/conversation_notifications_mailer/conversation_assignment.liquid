<p>Olá, {{user.available_name}}.</p>

<p>Uma nova conversa foi atribuída a você.</p>

{% for chat_message in conversation.recent_messages %}
  <div>
    <h4 style="margin: 0; color: #f2f7f4;">
      {% if chat_message.sender == user.available_name %}
        Você
      {% else %}
        {{chat_message.sender}}
      {% endif %}
    </h4>
  </div>

  <div style="padding: 10px 20px; margin: 5px 0 20px 0; background: #12291c; color: #c3cdc7; border-radius: 10px; display: inline-block; font-family: Arial, Helvetica, sans-serif; text-align: start; unicode-bidi: plaintext;">
    {% if chat_message.content %}
      {{chat_message.content}}
    {% endif %}

    {% if chat_message.attachments %}
      {% for attachment in chat_message.attachments %}
        Anexo [<a href="{{ attachment }}" _target="blank">clique para ver</a>]
      {% endfor %}
    {% endif %}
  </div>
{% endfor %}

<p><a href="{{action_url}}">Abrir a conversa</a></p>
